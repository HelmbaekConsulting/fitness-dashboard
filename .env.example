# Copy to .env and fill in. Never commit .env.

# Garmin Connect personal API key (Garmin Connect > account settings > personal API token). Expires; renew it there.
GARMIN_API_KEY=

# Withings developer app (developer.withings.com > Dashboard > Create an application, "Public API integration").
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Must match the callback URL registered in the Withings app, e.g. http://192.168.1.20:8080/withings/callback
WITHINGS_REDIRECT_URI=http://localhost:8080/withings/callback

# How far back the history backfill goes.
HISTORY_START=2019-01-01
# Sync times (container time zone, TZ), comma-separated for more than one, e.g. 09:00,21:00.
SYNC_TIME=09:00
# Optional password for the web pages (user name "me"). Leave empty on a trusted home network.
DASHBOARD_PASSWORD=
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel). Only the tunnel service in
# docker-compose.yml reads it. Never set up the tunnel's public hostname without a Cloudflare Access application.
CLOUDFLARE_TUNNEL_TOKEN=

# Local runs only; the container uses /data and /import.
# DATA_DIR=data
# IMPORT_DIR=data/import
